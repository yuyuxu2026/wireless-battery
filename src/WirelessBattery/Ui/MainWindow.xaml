<Window x:Class="WirelessBattery.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无线设备电量"
        Width="400"
        SizeToContent="Height"
        MaxHeight="680"
        MinHeight="220"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F6F4EF"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="RefreshButton" TargetType="Button">
            <Setter Property="Background" Value="#1F6B45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IntervalButton" TargetType="Button">
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#3F3C37"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E6E2DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6E6A62"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#DDD8CF" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="OnDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="无线设备电量" FontSize="18" FontWeight="SemiBold" Foreground="#1C1B19"/>
                    <TextBlock x:Name="SubtitleText" Text="正在读取设备…" Margin="0,4,0,0" Foreground="#6E6A62" FontSize="13"/>
                </StackPanel>
                <Button Grid.Column="1" Content="关闭" Click="OnHideClick" VerticalAlignment="Top" Style="{StaticResource QuietButton}"/>
            </Grid>

            <Button x:Name="RefreshButton" Grid.Row="1" Content="立即刷新" HorizontalAlignment="Left"
                    Margin="0,14,0,0" Click="OnRefreshClick" Style="{StaticResource RefreshButton}"/>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="查询间隔" Foreground="#6E6A62" FontSize="13"/>
                <UniformGrid x:Name="IntervalPanel" Columns="5" Margin="0,6,0,0">
                    <Button Content="1 分钟" Tag="1" Click="OnIntervalClick" Style="{StaticResource IntervalButton}"/>
                    <Button Content="10 分钟" Tag="10" Click="OnIntervalClick" Style="{StaticResource IntervalButton}"/>
                    <Button Content="20 分钟" Tag="20" Click="OnIntervalClick" Style="{StaticResource IntervalButton}"/>
                    <Button Content="30 分钟" Tag="30" Click="OnIntervalClick" Style="{StaticResource IntervalButton}"/>
                    <Button Content="60 分钟" Tag="60" Click="OnIntervalClick" Style="{StaticResource IntervalButton}"/>
                </UniformGrid>
            </StackPanel>

            <TextBlock x:Name="EmptyText" Grid.Row="3" Text="正在读取设备…" Margin="0,16,0,0"
                       Foreground="#6E6A62" Visibility="Collapsed"/>

            <ScrollViewer Grid.Row="4" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" MaxHeight="460">
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E6E2DA" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding Accent}" Margin="0,2,10,2"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B19"/>
                                        <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" Foreground="#3F3C37" FontSize="13"/>
                                        <TextBlock Text="{Binding Meta}" Margin="0,2,0,0" Foreground="#6E6A62" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{Binding Accent}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="FootnoteText" Grid.Row="5" TextWrapping="Wrap"
                       Margin="0,8,0,0" Foreground="#8A8478" FontSize="12"/>
        </Grid>
    </Border>
</Window>
